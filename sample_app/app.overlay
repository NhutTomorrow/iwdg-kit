/*
 * DeviceTree Overlay cho STM32:
 * 1. Kich hoat ngoai vi Independent Watchdog (IWDG)
 * 2. Kich hoat USB CDC ACM (Virtual COM Port) de xuat log qua Type-C
 */
/ {
	chosen {
		zephyr,console = &cdc_acm_uart0;
		zephyr,shell-uart = &cdc_acm_uart0;
	};

	aliases {
		watchdog0 = &iwdg;
	};
};

&iwdg {
	status = "okay";
};

&zephyr_udc0 {
	status = "okay";
	cdc_acm_uart0: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
	};
};
